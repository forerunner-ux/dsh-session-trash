{
  "name": "dsh-session-trash",
  "version": "1.1.0",
  "description": "Session recycle bin for the DSH sidebar: move a Session out of the sidebar into a trash area, then restore or permanently delete it from there.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "trash",
    "session",
    "recycle-bin"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forerunner-ux/dsh-session-trash.git"
  },
  "homepage": "https://github.com/forerunner-ux/dsh-session-trash#readme",
  "license": "MIT",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
